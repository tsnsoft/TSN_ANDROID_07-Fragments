<?xml version="1.0" encoding="utf-8"?>
<!-- Корневой контейнер первого вопроса занимает весь экран и отображает фон; внутри находится вертикальная колонка элементов. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@drawable/bg"
    android:orientation="horizontal"
    tools:context=".Fragment2">

    <!-- Основная колонка центрируется в родителе; ее содержимое располагается последовательно сверху вниз. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <!-- Текст вопроса находится первым в колонке, занимает ее ширину и выравнивается по центру с отступом 20dp. -->
        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:text="@string/question1"
            android:textAlignment="center"
            android:textColor="@color/colorWhite"
            android:textSize="20sp" />

        <!-- Квадратное изображение размером 100dp располагается под вопросом по центру; масштабирование сохраняет изображение внутри рамки. -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/image1" />

        <!-- Группа вариантов расположена под изображением и центрирована; стандартная ориентация RadioGroup размещает ответы вертикально. -->
        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp">

            <!-- Первый вариант ответа; отображается сверху в вертикальном списке. -->
            <RadioButton
                android:id="@+id/radioButton1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/манная"
                android:textColor="@color/colorWhite" />

            <!-- Второй вариант ответа; располагается под первым. -->
            <RadioButton
                android:id="@+id/radioButton2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/рисовая"
                android:textColor="@color/colorWhite" />

            <!-- Третий вариант ответа; располагается под вторым. -->
            <RadioButton
                android:id="@+id/radioButton3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/гороховая"
                android:textColor="@color/colorWhite" />

            <!-- Четвертый вариант ответа; отображается последним в группе. -->
            <RadioButton
                android:id="@+id/radioButton4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/гречневая"
                android:textColor="@color/colorWhite" />
        </RadioGroup>

        <!-- Строка навигации размещается под вариантами ответа; кнопки центрированы по горизонтали и разнесены отступами. -->
        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center">

            <!-- Кнопка возврата находится слева в строке навигации. -->
            <Button
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="25dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/button_bg"
                android:text="@string/назад"
                android:textColor="@color/colorWhite" />

            <!-- Кнопка продолжения находится справа от кнопки возврата. -->
            <Button
                android:id="@+id/nextBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/button_bg"
                android:text="@string/далее"
                android:textColor="@color/colorWhite" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>