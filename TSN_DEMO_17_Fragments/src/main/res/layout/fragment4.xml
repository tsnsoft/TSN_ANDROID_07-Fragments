<?xml version="1.0" encoding="utf-8"?>
<!-- Корневой контейнер итогового экрана занимает всю доступную область, задает фон и содержит вертикальную колонку. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@drawable/bg"
    android:orientation="horizontal"
    tools:context=".Fragment4">

    <!-- Основная колонка центрируется в родителе; благодарность, таблица и навигация идут сверху вниз. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <!-- Текст благодарности расположен вверху колонки, занимает ее ширину и выравнивается по центру с внешним отступом 20dp. -->
        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:text="@string/спасибо"
            android:textAlignment="center"
            android:textColor="@color/colorWhite"
            android:textSize="20sp" />

        <!-- Таблица выводится под благодарностью на всю ширину; строки с результатами могут добавляться программно. -->
        <TableLayout
            android:id="@+id/tableLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"></TableLayout>

        <!-- Строка навигации идет под таблицей; ее дочерние кнопки выровнены по центру горизонтально и отделены отступами. -->
        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center">

            <!-- Возврат к предыдущему экрану; кнопка стоит слева в строке навигации. -->
            <Button
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="25dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/button_bg"
                android:text="@string/назад"
                android:textColor="@color/colorWhite" />

            <!-- Повторный запуск опроса; кнопка стоит справа от кнопки возврата. -->
            <Button
                android:id="@+id/againBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/button_bg"
                android:text="@string/заново"
                android:textColor="@color/colorWhite" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>